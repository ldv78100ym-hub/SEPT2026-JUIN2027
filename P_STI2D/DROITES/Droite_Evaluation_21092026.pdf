\section*{Évaluation -- Droites}

\textbf{Rappel.} Une droite non verticale a une équation réduite de la forme
\[
y = mx + p,
\]
où \(m\) est le coefficient directeur et \(p\) l’ordonnée à l’origine.

\section{Deux points de coordonnées connues}

Déterminer l’équation réduite de la droite passant par les deux points donnés.

\begin{enumerate}
    \item \(A(-1\,;\,3)\) et \(B(3\,;\,11)\).
\end{enumerate}

\section{Un point et le coefficient directeur connus}

Déterminer l’équation réduite de la droite passant par le point donné et ayant pour coefficient directeur \(m\).

\begin{enumerate}
    \item \(A(-2\,;\,4)\), \(m = -2\).
\end{enumerate}

\section{Un point et l’ordonnée à l’origine connus}

Déterminer l’équation réduite de la droite passant par le point donné et dont l’ordonnée à l’origine est \(p\).

\begin{enumerate}
    \item \(A(-1\,;\,5)\), \(p = 2\).
\end{enumerate}

\section{Droite parallèle à une droite donnée}

On donne l’équation d’une droite \(d\) et un point \(A\) n’appartenant pas à \(d\). Déterminer l’équation réduite de la droite \(d'\) parallèle à \(d\) et passant par \(A\).

\begin{enumerate}
    \item \(d : y = -x + 3\), \(A(2\,;\,5)\).
\end{enumerate}

\section{À partir d’un graphique}

Le graphique ci-dessous représente une droite \(d\) dans un repère orthonormé. Déterminer graphiquement deux points de \(d\), puis en déduire son équation réduite.

\begin{center}
\begin{tikzpicture}[scale=0.7]
    % Grille
    \draw[step=1cm,gray!30,very thin] (-5,-5) grid (5,5);

    % Axes
    \draw[->,thick] (-5.5,0) -- (5.5,0) node[right] {\(x\)};
    \draw[->,thick] (0,-5.5) -- (0,5.5) node[above] {\(y\)};

    % Graduations
    \foreach \x in {-5,...,-1,1,...,5} {
        \draw (\x,0.1) -- (\x,-0.1) node[below] {\small \x};
    }
    \foreach \y in {-5,...,-1,1,...,5} {
        \draw (0.1,\y) -- (-0.1,\y) node[left] {\small \y};
    }
    \node[below left] at (0,0) {\small 0};

    % Droite d
    \draw[red,thick] (-4,-1) -- (3,2.5) node[right] {\(d\)};
\end{tikzpicture}
\end{center}

\section{Tracer une droite dans un repère}

Dans le repère ci-dessous, tracer la droite \(d\) passant par le point \(A(1\,;\,2)\) et de coefficient directeur \(m = -2\). Donner ensuite son équation réduite.

\begin{center}
\begin{tikzpicture}[scale=0.7]
    % Grille
    \draw[step=1cm,gray!30,very thin] (-5,-5) grid (5,5);

    % Axes
    \draw[->,thick] (-5.5,0) -- (5.5,0) node[right] {\(x\)};
    \draw[->,thick] (0,-5.5) -- (0,5.5) node[above] {\(y\)};

    % Graduations
    \foreach \x in {-5,...,-1,1,...,5} {
        \draw (\x,0.1) -- (\x,-0.1) node[below] {\small \x};
    }
    \foreach \y in {-5,...,-1,1,...,5} {
        \draw (0.1,\y) -- (-0.1,\y) node[left] {\small \y};
    }
    \node[below left] at (0,0) {\small 0};

    % Point A
    \fill (1,2) circle (2pt) node[above right] {\(A\)};
\end{tikzpicture}
\end{center}

\end{document}